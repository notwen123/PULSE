# CoinMarketCap Pro API key — server-side only. Never prefix with NEXT_PUBLIC_.
# Get one at https://pro.coinmarketcap.com/signup
# Without it, PULSE renders clearly labelled DEMO DATA for RWA pages;
# Fear & Greed and Altcoin Season still load live via CMC's keyless public API.
CMC_API_KEY=
# 60+data endpoints
# 15Kcall credits/mo

# Optional: override the API base URL (defaults to https://pro-api.coinmarketcap.com)
CMC_API_BASE_URL=
